{
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Warning",
          "Microsoft.EntityFrameworkCore": "Information"
        }
      },
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "outputTemplate": "[{Timestamp:dd-MM HH:mm:ss} {Level:u3}] |{SourceContext}| {NewLine} {Message:lj} {Properties:j}{NewLine}{Exception}"
          }
        },
        {
          "Name": "File",
          "Args": {
            "path": "Logs/log-.txt",
            "rollingInterval": "Day",
            "rollOnFileSizeLimit": "true", 
            "retainedFileCountLimit": 7,
            "shared": true,
            "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
          }
        }
      ]
    },
  "ConnectionStrings": {
    "RestaurantDb": "Server=(localdb)\\mssqllocaldb;database=RestaurantDb;Trusted_Connection=True;"
  },
  "AllowedHosts": "*"
}
